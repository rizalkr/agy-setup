{
  "mcpServers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?project_ref=YOUR_SUPABASE_PROJECT_REF&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback",
      "serverUrl": "https://mcp.supabase.com/mcp?project_ref=YOUR_SUPABASE_PROJECT_REF&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback"
    },
    "wordcraft": {
      "command": "wordcraft-cli",
      "args": [
        "mcp"
      ]
    },
    "jupyter": {
      "command": "uvx",
      "args": [
        "jupyter-mcp-server@latest"
      ],
      "env": {
        "DOCUMENT_URL": "http://localhost:8888",
        "RUNTIME_URL": "http://localhost:8888",
        "RUNTIME_TOKEN": "YOUR_JUPYTER_TOKEN"
      }
    }
  }
}
